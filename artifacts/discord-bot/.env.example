# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord application/client ID (General Information → Application ID)
DISCORD_CLIENT_ID=your_client_id_here

# Your Discord server (guild) ID — commands register INSTANTLY when this is set
# Right-click your server icon in Discord → Copy Server ID (requires Developer Mode)
# Remove this line to use global registration instead (up to 1 hour delay)
DISCORD_GUILD_ID=your_guild_id_here

# The Discord channel ID where status updates will be posted
# Can also be set at runtime with /setchannel
STATUS_CHANNEL_ID=your_channel_id_here

# Minecraft server connection details
MC_HOST=oneman.falixsrv.me
MC_PORT=21190
MC_QUERY_HOST=162.55.100.208
MC_QUERY_PORT=25565
